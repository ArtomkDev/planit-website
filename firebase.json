{
  "hosting": {
    "target": "legal",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(uk|en){,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/auth/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(icon|apple-icon|opengraph-image|twitter-image)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          },
          {
            "key": "Cache-Control",
            "value": "public,max-age=300,must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2|png|jpg|jpeg|gif|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|json|txt|xml|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/content/legal/**/*.mdx",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/en/wiki",
        "destination": "/en/wiki/terms",
        "type": 301
      },
      {
        "source": "/uk/wiki",
        "destination": "/uk/wiki/terms",
        "type": 301
      },
      {
        "source": "/uk/privacy",
        "destination": "/uk/wiki/privacy",
        "type": 301
      },
      {
        "source": "/uk/terms",
        "destination": "/uk/wiki/terms",
        "type": 301
      },
      {
        "source": "/uk/cookies",
        "destination": "/uk/wiki/cookies",
        "type": 301
      },
      {
        "source": "/uk/delete",
        "destination": "/uk/wiki/delete",
        "type": 301
      },
      {
        "source": "/uk/licenses",
        "destination": "/uk/wiki/licenses",
        "type": 301
      },
      {
        "source": "/en/privacy",
        "destination": "/en/wiki/privacy",
        "type": 301
      },
      {
        "source": "/en/terms",
        "destination": "/en/wiki/terms",
        "type": 301
      },
      {
        "source": "/en/cookies",
        "destination": "/en/wiki/cookies",
        "type": 301
      },
      {
        "source": "/en/delete",
        "destination": "/en/wiki/delete",
        "type": 301
      },
      {
        "source": "/en/licenses",
        "destination": "/en/wiki/licenses",
        "type": 301
      }
    ]
  }
}
