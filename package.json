{
  "name": "planit-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:firebase": "npm run build",
    "deploy:firebase": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-firebase.ps1",
    "deploy:firebase:preview": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-firebase.ps1 -Channel preview",
    "deploy:firebase:skip-build": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-firebase.ps1 -SkipBuild",
    "firebase:login": "firebase login",
    "firebase:logout": "firebase logout",
    "legal:manifest": "node scripts/update-legal-manifest.mjs",
    "legal:sync": "node scripts/sync-legal-documents.mjs",
    "legal:publish": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-firebase.ps1 -SyncLegalDocuments",
    "preview:export": "node scripts/serve-static-export.mjs",
    "start": "node scripts/serve-static-export.mjs",
    "lint": "eslint",
    "graphify": "powershell -ExecutionPolicy Bypass -File ./scripts/graphify.ps1",
    "graphify:build": "powershell -ExecutionPolicy Bypass -File ./scripts/graphify.ps1 .",
    "graphify:build-code": "powershell -ExecutionPolicy Bypass -File ./scripts/graphify.ps1 extract . --code-only",
    "graphify:update": "powershell -ExecutionPolicy Bypass -File ./scripts/graphify.ps1 update .",
    "graphify:query": "powershell -ExecutionPolicy Bypass -File ./scripts/graphify.ps1 query",
    "graphify:install-codex": "powershell -ExecutionPolicy Bypass -File ./scripts/graphify.ps1 install --project --platform codex",
    "prebuild": "node scripts/validate-content.mjs && npm run legal:manifest",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:export": "node --test tests/export/*.test.mjs",
    "postbuild": "node scripts/prepare-export.mjs && node scripts/verify-export.mjs --record-build",
    "check:export": "node scripts/verify-export.mjs",
    "check:live": "node scripts/verify-live.mjs",
    "site:update": "node scripts/site-update.mjs",
    "site:check": "node scripts/site-update.mjs --check",
    "page:new": "node scripts/new-page.mjs",
    "check:seo": "node scripts/prepare-export.mjs --check"
  },
  "dependencies": {
    "@next/env": "16.2.9",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.40.0",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/caseless": "^0.12.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/request": "^2.48.13",
    "@types/three": "^0.185.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "firebase-tools": "^15.24.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
